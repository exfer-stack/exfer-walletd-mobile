{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main webview (mobile + desktop)",
  "windows": ["main"],
  "platforms": ["iOS", "android", "linux", "macOS", "windows"],
  "permissions": [
    "core:default",
    "notification:default",
    "opener:default",
    "clipboard-manager:allow-write-text",
    "clipboard-manager:allow-read-text",
    "dialog:allow-save",
    "dialog:allow-open",
    "fs:allow-read-file",
    "fs:allow-write-file",
    "fs:default"
  ]
}
